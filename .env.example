# HealthLens Environment Variables
# Copy this file to .env and fill in your API keys.
# .env is gitignored; never commit real keys.

# Kimi AI API Key (legacy direct integration — superseded by AI_PROXY)
KIMI_API_KEY=

# Gemini API Key (legacy direct integration — superseded by AI_PROXY)
GEMINI_API_KEY=

# MiniMax API Key (for image generation)
MINIMAX_API_KEY=

# AI Proxy (server-side relay for KimI/MiniMax) — REQUIRED
AI_PROXY_URL=https://your-proxy.example.com
AI_PROXY_TOKEN=replace-with-proxy-token